#!/usr/bin/env bash
# Fake gcloud for the tests.
case "$*" in
  "auth print-access-token"*)
    if [[ -n "${FAKE_GCLOUD_FAIL:-}" ]]; then
      printf '%s\n' "$FAKE_GCLOUD_FAIL" >&2
      exit 1
    fi
    printf 'gcloud auth print-access-token account=%s override=%s\n' "${CLOUDSDK_CORE_ACCOUNT:-}" "${CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE:-}" >>"${FAKE_CURL_LOG:-/dev/null}"
    printf '%s\n' "${FAKE_GCLOUD_TOKEN:-fake-x-token}"
    ;;
  "config get-value auth/impersonate_service_account") printf '%s\n' "${FAKE_GCLOUD_IMPERSONATE:-}" ;;
  "config get-value account") printf 'tester@example.com\n' ;;
  "apigee --help") exit 0 ;;
  "apigee "*" list "*)
    printf '%s' "${FAKE_GCLOUD_LIST-p1
p2
}" ;;
  *) exit 1 ;;
esac
