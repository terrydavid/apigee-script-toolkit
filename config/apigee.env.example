# apigee-toolkit configuration.
#
# Copy to config/apigee.env (git-ignored) or ~/.config/apigee-toolkit/apigee.env
# for defaults, or to config/profiles/<name>.env /
# ~/.config/apigee-toolkit/profiles/<name>.env for named profiles
# (`apigee profile use <name>`, `apigee --profile <name> ...`,
# `source bin/apigee-env <name>`).
#
# Settings only. NEVER put passwords, tokens or client secrets in this file:
# use environment variables for the current shell, or the macOS Keychain.

# Platform: x (Apigee X), hybrid (same API as X) or edge (Apigee Edge SaaS / private cloud)
APIGEE_PLATFORM=x

# Organization and default environment
APIGEE_ORG=my-org
APIGEE_ENV=test

# --- Apigee X / hybrid ------------------------------------------------------
# Auth is `gcloud auth print-access-token`. Optionally pin the gcloud account:
# CLOUDSDK_CORE_ACCOUNT=you@example.com
# Management API base URL (default https://apigee.googleapis.com/v1):
# APIGEE_X_API_URL=https://apigee.googleapis.com/v1

# --- Apigee Edge ------------------------------------------------------------
# Management server (default https://api.enterprise.apigee.com; /v1 is appended)
# APIGEE_EDGE_MGMT_URL=https://api.enterprise.apigee.com
# Auth mode: oauth (default; Edge OAuth2 token endpoint), basic, or token (use APIGEE_TOKEN)
# APIGEE_EDGE_AUTH=oauth
# APIGEE_EDGE_USER=you@example.com
# OAuth2 token endpoint (SAML/SSO orgs use https://<zone>.login.apigee.com/oauth/token)
# APIGEE_EDGE_TOKEN_URL=https://login.apigee.com/oauth/token
#
# Keychain service names (macOS). The password is looked up with account
# $APIGEE_EDGE_USER; the SSO client id:secret with account "client".
#   security add-generic-password -U -s apigee-toolkit-edge -a "$APIGEE_EDGE_USER" -w
#   security add-generic-password -U -s apigee-toolkit-edge-sso-client -a client -w
# APIGEE_EDGE_KEYCHAIN_SERVICE=apigee-toolkit-edge
# APIGEE_EDGE_SSO_KEYCHAIN_SERVICE=apigee-toolkit-edge-sso-client
#
# Secrets may instead come from the environment of the current shell only:
#   APIGEE_EDGE_PASSWORD, APIGEE_EDGE_SSO_CLIENT (client_id:client_secret),
#   APIGEE_EDGE_PASSCODE (SSO one-time passcode), APIGEE_EDGE_MFA_CODE,
#   APIGEE_TOKEN (pre-fetched bearer token, any platform)

# --- KVM reader proxy (optional) -------------------------------------------
# Edge never returns values of encrypted KVMs. If you deploy a small proxy that
# reads a KVM entry with a KeyValueMapOperations policy and answers
# GET <url>?mapname=<map>&key=<key> with the raw value, point to it here.
# APIGEE_KVM_READER_URL=https://my-org-test.apigee.net/kvm-reader
# Send the management bearer token to that proxy: none (default) or bearer
# APIGEE_KVM_READER_AUTH=none

# --- Misc -------------------------------------------------------------------
# JSON engine: auto (jq, else python3), jq, python
# APIGEE_JSON_ENGINE=auto
# Set to 1 to disable the on-disk Edge token cache (~/.cache/apigee-toolkit)
# APIGEE_NO_TOKEN_CACHE=0
