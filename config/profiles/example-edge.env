# Example Apigee Edge profile. Copy to <name>.env and edit.
# Password / SSO client credentials come from the Keychain or the environment.
APIGEE_PLATFORM=edge
APIGEE_ORG=my-edge-org
APIGEE_ENV=test
APIGEE_EDGE_MGMT_URL=https://api.enterprise.apigee.com
APIGEE_EDGE_AUTH=oauth
APIGEE_EDGE_USER=you@example.com
# APIGEE_EDGE_TOKEN_URL=https://login.apigee.com/oauth/token
