#!/bin/bash

# getSFs
#
# lists the sharedflows
#
# usage:
#   getApis sharedflow_name  revision

#set -e

USAGE="apiproxy_name revision"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1 2

theSF="${ARGS[0]}"
theRevision="${ARGS[1]}"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/sharedflows/${theSF}/revisions/${theRevision}"
debug "Retrieving SharedFlow from ${URL}"

http_get "$URL"

if [[ $STATUS_CODE -ge 202 ]]; then
	debug "\nFailure RESPONSE: \n$RESPONSE"
	fail "Failed with status [$STATUS_CODE]"
else
	echo "$RESPONSE"
fi

