#!/bin/bash

#
# deleteShF
# deletes a sharedflow
##
# usage:
#   deleteShF sharedflow_name revision

#set -e

USAGE="sharedflow_name revision#"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2

theShF="${ARGS[0]}"
theRevision="${ARGS[1]}"

if [[ $theRevision -eq "" ]] ; then
    echo "Revision is required"
    exit 1
fi

URL="${APIGEE_HOST}/o/${ORGANIZATION}/sharedflows/${theShF}/revisions/${theRevision}"
debug "Deleting ${URL}"

http_delete "$URL"

echo -e "Deleted ${theShF} revision ${theRevision}: Status Code = $STATUS_CODE"
