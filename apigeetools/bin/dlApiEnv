#!/bin/bash
# dlApiEnv
# 
# 1st half of moving an API Env
#	Captures all ENV specific artifacts into dir structure
#
#	TODO:
#		Add "clean old stuff" for each section
#
USAGE="<none>"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2 4

# addnl functions:
getcaches () {
	DIR=$1
	[[ ! -d ${DIR}/caches ]] && mkdir "${DIR}/caches"

	# Scan for caches
	CALIST=`getCaches`
	for ca in $CALIST; do
	    echo "thisCache: ${ca} "
	    getCache ${OPTS[@]} ${ca} | sed -e 's/[",\[]//g' -e 's/\]//g' > ${DIR}/caches/${ca}.json
	done
}

gettargets () {
	DIR=$1
	[[ ! -d ${DIR}/targets ]] && mkdir "${DIR}/targets";

	# Scan for target serverss
	TSLIST=`getTargetServers`
	for ts in $TSLIST; do
	    echo "thisTS: ${ts} "
	    # DEBUG=2
	    TSLIST=`getTargetServer ${ts} | sed -e 's/[",\[]//g' -e 's/\]//g' > ${DIR}/targets/${ts}.json`
	    # DEBUG=0
	    # sleep 2  # Debug for TS timeouts
	done
}

getvhosts () {
	DIR=$1
	[[ ! -d ${DIR}/vhosts ]] && mkdir "${DIR}/vhosts";

	# get the list of virtual hosts
	VHLIST=`getVirtualHosts`
	for vh in $VHLIST; do
	    echo "thisVH: ${vh}"
	    VHOST=`getVirtualHost ${vh} | sed -e 's/[",\[]//g' -e 's/\]//g' > ${DIR}/vhosts/${vh}.json`
	done
}

# KVMs come in 2 flavors; 
#	configuration that is for the specific environment but does not change during 
#	functional operation (we create as needed the directory and the JSON file of the results),
#	and operational KVMS that hold variable information across multiple requests
#	(we only create as needed the directory. Its name will create KVM at upload time)
#
#				TODO: 	Fix Config KVMs!!!
getkvms() {
	DIR=$1
	kvmDIR="$DIR/kvms"
	[[ ! -d ${kvmDIR} ]] && mkdir ${kvmDIR}

	KLIST=`getKVMs | sort -u`
	debug "KLIST= $KLIST"
	for k in $KLIST; do 

	    echo "thisKVM: ${k}"
	    KVM="$(getKVM ${k})" 

	    KDIR="${kvmDIR}/${k}";
	    [[ ! -d ${KDIR} ]] && mkdir "${KDIR}";
		debug "KVM: $KVM \n KDIR; $KDIR"

	    CFG=""; [[ `echo "$k"` ]] && CFG=true;
	    [[ ${CFG} ]] && [[ -d ${KDIR} ]] && echo "$KVM" > $KDIR/$k.json;
	done
}

getsharedflows() {
	DIR=$1
	shDIR="$DIR/shFlows"
	[[ ! -d ${shDIR} ]] && mkdir ${shDIR}

	SFLIST=`getSFs`
	# SFLIST='sf-cors-v1' # Singles for debugging
	debug "SFLIST=$SFLIST"

	for sf in $SFLIST ; do
		echo -n "thisSF: " # for each SF, download the revision deployed for that environment
		SFREV=`getSFRevisionDeployed ${sf} 2>/dev/null`

		if  [[ $? -eq 0 && ${SFREV} -ge 1 ]]  ; then
			debug "dlSFlow ${sf} $SFREV "
			echo "${sf}:${SFREV}" 
			dlSFlow ${sf} $SFREV
		
			SFDIR="${shDIR}/${sf}_${SFREV}"
			[[ ! -d "${SFDIR}" ]] && mkdir "${SFDIR}"

			if [[ -f ${shDIR}/${sf}-${SFREV}.zip ]] ; then
				debug "unzip -oqu ${shDIR}/${sf}-${SFREV}.zip -d ${SFDIR}"
				unzip -oqu ${shDIR}/${sf}-${SFREV}.zip -d ${SFDIR}
				mv ${shDIR}/${sf}-${SFREV}.zip ${SFDIR}
			else
				echo "${shDIR}/${sf}-${SFREV}.zip Not Found"
			fi
		else
			echo "A Deployed Revision of SharedFlow ${sf} is Not Found: [404]  "
		fi
	done
}

getapiproxies () {
	DIR="$1/apis"
	[[ ! -d ${DIR} ]] && mkdir ${DIR}
	cd ${DIR}

	ALIST=`getApis` # retrieves list of apis in this ENV
	# ALIST="v2-airs" # Unit test only
	debug "ALIST=\n$ALIST"

	for a in $ALIST ; do
		[[ $DEBUG -ge 2 ]] && echo -en "\n================================================================================\n\n"
		echo -en "thisAPI: " # for each API Proxy, download the revision deployed for that environment

		# find the deployed revision
		AREV=`getApiRevisionDeployed ${OPTS[@]} ${a} 2>/dev/null`
		 
		# find the latest revision
		# AREV=`getApiRevisionLatest ${OPTS[@]} ${a} 2>/dev/null` 
		
		# If there is a deployed revision, then do work
		if [[ $? -eq 0 && ${AREV} -ge 1 ]] ; then
			echo "${a}:${AREV}"
			ADIR="${DIR}/${a}_${AREV}"
			[[ ! -d "${ADIR}" ]] && mkdir ${ADIR}

			# download the revision"
			debug "\nDownloading Proxy= ${a}; AREV= ${AREV}; APISDIR= ${APISDIR}; DIR= ${DIR}; ADIR= ${ADIR}; PWD= `pwd`;\n"
			dlApi ${a} ${AREV}   # download the revision
			# echo "AREV= ${AREV}"
			if [[ -f ${DIR}/${a}-${AREV}.zip ]] ; then
				# explode the zip and store in the proxy subdir
				debug "unzip -oqu ${DIR}/${a}-${AREV}.zip -d ${ADIR}"
				unzip -oqu ${DIR}/${a}-${AREV}.zip -d "${ADIR}"
				mv ${DIR}/${a}-${AREV}.zip ${ADIR} 
			else
				echo "${DIR}/${a}-${AREV}.zip Not Found"
			fi
		else
			echo "A Deployed Revision of API ${a} is Not Found: [404] "
		fi
	done
}

# MAIN starts here; ENV is controlled by .apigee file
# MAIN starts here; ENV is controlled by .apigee file
# MAIN starts here; ENV is controlled by .apigee file

[[ $DEBUG -ge 3 ]] && set -x

if [[ ! -d ${APISDIR} ]] ; then
	echo -en "${APISDIR}= ${APISDIR} is not found: [404]"
	exit 1
else
	cd ${APISDIR}; cd ..
	ENVDIR=`pwd`
	BZF="${ENVDIR}/${ORG}-${ENV}.bkp.zip"
	echo -en "Backing up: ${ENVDIR}/* to ${BZF} \n\n"
	zip -qr ${BZF} ${ENVDIR}
	echo "done $?"
	[[ $? != 0 ]] && exit
	# mv ${APISDIR}/${ORG}-${ENV}.bkp.zip ..
	# rm -fr ${APISDIR}/*
fi

echo -en "\n***** Downloading the ${ENV} environment to directory ${ENVDIR} *****\n"

# # Find API proxies and download
# echo -en "\n\tGetting Proxies\n"
# getapiproxies ${ENVDIR}

# # Find SharedFlows and download
# echo -en "\n\tGetting SharedFlows\n"
# getsharedflows ${ENVDIR}
# # TODO? loop to check SFs for embedded SFs

# # Find KVMs and download info
# echo -en "\n\tGetting KVMS\n"
# getkvms ${ENVDIR}

# # Find TargetServers & download
# echo -en "\n\tGetting TargetServers\n"
# gettargets ${ENVDIR}

# # Find VirtualHosts & download
# echo -en "\n\tGetting VirtualHosts\n"
# getvhosts ${ENVDIR}

# Find for Caches & download
echo -en "\n\tGetting Caches\n"
getcaches ${ENVDIR}

echo -en "\n\t************ End of processing `basename $0` **********\n\n"

cd -
set -
