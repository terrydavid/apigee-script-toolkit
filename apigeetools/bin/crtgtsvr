#!/bin/bash

#
# createTargetServer
# creates an SSL-enabled virtual host
#
# usage:
#   crtgtsvr "TargetServerName"

USAGE="target_server_config_file(.json)"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1 1

TSfile="${ARGS[0]}"
# Should check that file is JSON

HDRS="-HAccept:application/json -HContent-Type:application/json"
curlOPTS="--data @${TSfile}"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/targetservers"

debug "URL: $URL; TSFILE= $TSFILE"
 
http_post "${URL}"
