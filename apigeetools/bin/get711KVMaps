#!/bin/bash

# 1. set711e (mod envs)
# 2. get711KVMaps > .txt
# 3. get711KVMNames > .keys
# 4. get711KVMValue > .kvm
#
# getKVMValue
# 	gets a KVM value for the keyname
#
#Scoped to environment:
#  https://api.enterprise.apigee.com/o/{org_name}/environments/{env_name}/keyvaluemaps
#

#set -e

USAGE="environment"
TOOLSDIR="${APITOOLS_HOME}"
. "${APITOOLS_HOME}/lib/functions"
parseCommandline "$@"
checkArgs 2 2
FRMT="json"

ENVIRON=${ARGS[0]}

debug "get711KVMaps $ENVIRON"

set -x
curl -L -H "Authorization: Bearer $MyTOKEN" $APIGEE_HOST/organizations/$ORGANIZATION/environments/$ENVIRON/keyvaluemaps | sed -e 's/[\"\,\[]//g' -e 's/\]//g' > $ENVIRON-711-map-names.txt
set -

echo "Map names are in $ENVIRON-711-map-names.txt"
