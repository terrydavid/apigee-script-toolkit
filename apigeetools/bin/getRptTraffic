#!/bin/bash

# getRptTraffic
#
# gets the analytics report requested
#
# usage:
#   getRptTraffic
#   The time format is: MM/DD/YYYY%20HH:MM~MM/DD/YYYY%20HH:MM
#     where '%20' represents a space character. For this
#     script, you need only pass in the start and end dates in the 
#     proper format.

USAGE="start_date end_date  # ouput is simple list"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2

DATEFROM="${ARGS[0]}"
DATETO="${ARGS[1]}"

# [[ ${ARGS[0]} ]] && RPTID="/${ARGS[0]}"
# URL="${APIGEE_HOST}/organizations/${ORGANIZATION}/reports${RPTID}"

URL="${APIGEE_HOST}/organizations/${ORGANIZATION}/environments/${ENVIRONMENT}/stats/\
apiproxy?select=sum(message_count),sum(is_error),tps&\
timeRange=${DATEFROM}%2000:00:00~${DATETO}%2000:00:00" 

http_get "${URL}"

echo "$RESPONSE" 
# | $TOOLSDIR/lib/jp.sh | jsonValueOf "values"