#!/bin/bash
 
# deployApi
#
# deploys the specified revision of an API to an environment 
#
# usage:
#   deployApi  api revision
#		api the name of the api to deploy
# 		revision the revision to deploy (use "latest" to deploy the latest revision)

#set -e

USAGE="api_name revision"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2 2

APINAME=${ARGS[0]}
if [ "$APINAME" == "" ]; then
	usefail "No API name specified"
fi

REVISION=${ARGS[1]}
if [ "$REVISION" == "latest" ]; then
	REVISION=`getApiRevisionLatest ${OPTS[@]} "$APINAME"`
	if [ "$REVISION" == "" ]; then
		usefail "no revisions of API $APINAME in environment $ENVIRONMENT"
	fi
fi
if [ "$REVISION" == "" ]; then
	usefail "No revision specified"
fi

HDRS="-HContent-Type:application/x-www-form-urlencoded"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/apis/${APINAME}/revisions/${REVISION}/deployments?override=true"

debug "Deploying revision $REVISION of API $APINAME in environment $ENVIRONMENT"
http_post "$URL"

if [[ ${STATUS_CODE} -ge 202 ]]; then
	fail "Failed with status ${STATUS_CODE}: \nResponse= \n${RESPONSE}" 
else
	echo -en "Revision $REVISION of API $APINAME now deployed in environment $ENVIRONMENT w/\n\t STATUS_CODE= ${STATUS_CODE}"
fi
