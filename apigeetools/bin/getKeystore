#!/bin/bash

# getKeystore
#
# retrieves details about a keystore
#
# usage:
#   getKeystore environment keystore_name

#set -e

USAGE="keystore_name"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1

KEYSTORE_NAME=${ARGS[0]}

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/keystores/${KEYSTORE_NAME}"

http_get "$URL" "-HAccept:application/json"

if [[ ${STATUS_CODE} == 200 ]] ; then
    echo $RESPONSE | jq .
else
    echo ${STATUS_CODE} returned
fi
