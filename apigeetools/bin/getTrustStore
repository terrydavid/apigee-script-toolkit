#!/bin/bash

# getTrustStore
#
# lists the virtual hosts defined for an environment
#
# usage:
#   getVirtualHosts environment

#set -e

USAGE="truststore"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/keystores/${ARGS[0]}"

http_get "$URL"

echo "$RESPONSE"
