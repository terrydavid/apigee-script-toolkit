#!/bin/bash

# getCaches
#
# retrieves the caches defined for an environment
#
# usage:
#   getCaches environment

#set -e

USAGE="no parms"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/caches"

http_get $URL

for a in $RESPONSE ; do printf "%b\n" $a | sed -e 's/[",\[]//g' -e 's/\]//g' ; done

# echo "$RESPONSE"