#!/bin/bash

#
# 1. set711e (mod envs)
# 2. get711KVMaps > .txt
# 3. get711KVMNames > .keys
# 4. get711KVMValue > .kvm
#
# getKVMValue
# 	gets a KVM value for the keyname
#
#Scoped to environment:
#  https://api.enterprise.apigee.com/o/{org_name}/environments/{env_name}/keyvaluemaps
#

USAGE="environment keyvaluemap_name"
TOOLSDIR="${APITOOLS_HOME}"
. "${APITOOLS_HOME}/lib/functions"
parseCommandline "$@"
# checkArgs 2 2
FRMT="json"

ENVIRON=${ARGS[0]}
KVMN=${ARGS[1]}

set -x 

debug "[g7keys]: ENVIRON= $ENVIRON; KVMN= $KVMN"
: > $KVMN-$ENVIRON-711.kvm

for k in `cat $KVMN-$ENVIRON-711.keys` ; do
set -x
    debug "get711KVMValue $KVMN ${k}"
    echo "v=`get711KVMValue $KVMN ${k}`"
    v=`get711KVMValue $KVMN ${k}`
    debug "[g7keys]: v= $v"
    [[ !$v ]] && continue
    echo "$k;$v"
done > $KVMN-$ENVIRON-711.kvm 2>/dev/null
echo -en "k= $k; KVM $KVMN=\n`cat $KVMN-$ENVIRON-711.kvm`"
set -


