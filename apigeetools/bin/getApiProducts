#!/bin/bash

# getApiProduct
#
# retrieves an API product
#
# usage:
#   getApiProduct host_alias product_name

USAGE=""
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1

URL="${APIGEE_HOST}/o/${ORGANIZATION}/apiproducts"

http_get "${URL}"

echo $RESPONSE
echo $STATUS_CODE
