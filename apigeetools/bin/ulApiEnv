parseCommandline "$@"
checkArgs 2 4

DBG=""
DBG="-d3"

OUTFILE="APIRevList.out"

# addnl functions:
puttargets () {
	DIR=$1/targets
	[[ ! -d ${DIR} ]] && echo "${DIR} not found" && exit "-2";

	# TSLIST=`ls ${DIR}`
	TSLIST="TS-AIRS-01.json"			# Single for debugging
	debug "TSLIST= \n$TSLIST"

	for ts in $TSLIST; do
	    echo -en "\nthisTS: ${ts} "
		echo "CMD> crtgtsvr ${DBG} ${DIR}/${ts}"
	    crtgtsvr ${DBG} ${DIR}/${ts}
	done
}

