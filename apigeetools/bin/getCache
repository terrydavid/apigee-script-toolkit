#!/bin/bash

# getCache 
#
# retrieves the configuration of a cache for an environment
#
# usage:
#   getCache cache_name

#set -e

USAGE="cache_name"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1

CACHE="${ARGS[0]}"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/caches/${CACHE}"

http_get $URL

echo "$RESPONSE"