export MyTOKEN=

# Log in to gcloud
if [ ! $MyTOKEN ] ; then
    set -x
    # export MyTOKEN=`
    curl -v --location 'https://7-eleven-7ep-infra-saml.login.apigee.com/oauth/token' --header 'Content-Type: application/x-www-form-urlencoded;charset=utf-8' --header 'Authorization: Basic ***REMOVED***' --data-urlencode 'grant_type=password' --data-urlencode 'username=7ep_migration_machine_user@7-11.com' --data-urlencode 'password=***REMOVED***$UJLR_V432urB3BXjOE$' --data-urlencode 'response-type=token' | jq '.access_token' | sed 's/\"//g'
    set -
fi

exit 

