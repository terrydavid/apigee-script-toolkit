#!/bin/bash
 
# deploySF
#
# deploys the specified revision of a SF to an environment 

#
# usage:
#   deploySF  sharedflow revision
#		sharedflow the name of the api to deploy
# 		revision the revision to deploy (use "latest" to deploy the latest revision)

#set -e

USAGE="sharedflow_name revision"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2 2

SFNAME=${ARGS[0]}
if [ "$SFNAME" == "" ]; then
	usefail "No SharedFlow name specified"
fi

REVISION=${ARGS[1]}
if [ "$REVISION" == "latest" ]; then
	REVISION=`getSFRevisionLatest ${OPTS[@]} "$SFNAME"`
	if [ "$REVISION" == "" ]; then
		fail "no revisions of SharedFlow $SFNAME in environment $ENVIRONMENT"
	fi
fi

if [ "$REVISION" == "" ]; then
	usefail "No revision specified"
fi

export BODY="override=true"
export curlOPTS="-d ${BODY}"
export HDRS="-HContent-Type:application/x-www-form-urlencoded -HContent-Length:${#BODY}"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/sharedflows/${SFNAME}/revisions/${REVISION}/deployments"

debug "Deploying revision $REVISION of SF $SFNAME in environment $ENVIRONMENT"
http_post "$URL"

if [[ ${STATUS_CODE} -ge 202 ]]; then
	fail "Failed with status ${STATUS_CODE}: \nResponse= \n${RESPONSE}"
else
	echo -en "Revision $REVISION of SharedFlow $SFNAME now deployed in environment $ENVIRONMENT w/\n\t STATUS_CODE= ${STATUS_CODE}"
fi
