#!/bin/bash

# getTargetServer
#
# lists the virtual hosts defined for an environment
#
# usage:
#   getVirtualHosts environment

#set -e

USAGE="environment"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"

URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/keystores"

http_get "$URL"

echo "$RESPONSE"
