#!/bin/bash

#
# deleteAPIRevision
# deletes an API revision
#
#
# usage:
#   deleteApiRevision api_name revision

#set -e

USAGE="api_name revision"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2

theApi="${ARGS[0]}"
theRevision="${ARGS[1]}"

if [[ $theRevision -eq "" ]] ; then
    echo "Revision is required"
    exit 1
fi

URL="${APIGEE_HOST}/o/${ORGANIZATION}/apis/${theApi}/revisions/${theRevision}"
debug "Deleting ${URL}"

http_delete "$URL"

echo "Status Code = $STATUS_CODE"
