#!/bin/bash


# getApiProduct
#
# retrieves an API product
#
# usage:
#   getApiProduct host_alias product_name

#set -e
#set -x

USAGE="<none>"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 1

#URL="${APIGEE_HOST}/o/${ORGANIZATION}/e/${ENVIRONMENT}/keyvaluemaps"

#http_get "${URL}"


for n in `cat kvmap.names` ; do 
    echo "n= $n"
    cat $n-stage-711-names.txt 
    for k in `cat $n-stage-711-names.txt`; do 
        echo "k= $k"
        get711KVMValue ${n} ${k} 
        v=`get711KVMValue ${n} ${k}` 
        echo "$k;$v" | tee -a $n-stage-711.kvm 
    done 2>/dev/null 
    cat $n-stage-711.kvm 
done


