#!/bin/bash
 
# import
#
# imports an API bundle
#
# usage:
#   importapi api zip_file
#       api the name of the api
#       zip_file the name of the apiproxy zip file (default is ./apiproxy.zip)   
#		revision [optional]

#set -e

USAGE="api zip_file [revision]"  # 'import' a .zip file as the name 'api'"
TOOLSDIR="${APITOOLS_HOME}"
. "$TOOLSDIR/lib/functions"
parseCommandline "$@"
checkArgs 2 3

APINAME=${ARGS[0]}
APIPROXYZIP=${ARGS[1]} # zip file was passed in
APIPROXYREV=${ARGS[2]}

if [[ ! -f "${APIPROXYZIP}" ]] ; then
	fail "${APIPROXYZIP} File Not Found"
fi

if [[ "${APIPROXYREV}_" == "_" ]] ; then
	URL="${APIGEE_HOST}/o/${ORGANIZATION}/apis?action=import&name=${APINAME}"
else
	URL="${APIGEE_HOST}/o/${ORGANIZATION}/apis/${APINAME}/revisions/${APIPROXYREV}?validate=true"
fi
debug "importing API ${APINAME} via ${URL}"

#HDRS="-HContent-Type:application/octet-stream"
#curlOPTS="--data-binary \'@${APIPROXYZIP}\'"
HDRS="-HContent-Type:multipart/form-data"
curlOPTS="-F file=@${APIPROXYZIP}"

http_post "$URL"

# JSON_OUTPUT=`echo "$RESPONSE" | "$TOOLSDIR/lib/jp.sh" -b`
debug "RESPONSE= $RESPONSE"
debug "APIPROXYREV = $APIPROXYREV"
# API_NAME=`echo "$JSON_OUTPUT" | awk '/\[\"name\"\,?([0-9])*/ {print $2}' | sed 's/\"//g'`
debug "APINAME = $APINAME"

echo "imported revision `getApiRevisionLatest $APINAME` of API $APINAME"
